use serde::{Deserialize, Serialize};



#[derive(Debug, Default, Serialize, Deserialize)]
#[serde(rename_all = "camelCase")]
struct PwNode {
    id: u32,
    name: String,
    nick: String,
    type_: String,
    class: String,
    description: String,
}

#[derive(Debug, Default, Serialize, Deserialize)]
#[serde(rename_all = "camelCase")]
struct PwNodeProps {
    id: u32,
    volume: (f32, f32),
    muted: bool,
}

#[derive(Debug)]
pub enum PwEvent {
    NodeAdded(PwNode),
    NodeRemoved(u32),
    NodeProps(PwNodeProps),
}
