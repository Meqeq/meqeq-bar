{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "meqeq-bar",
  "version": "0.1.0",
  "identifier": "com.meqeq-bar.app",
  "build": {
    "beforeDevCommand": "export WEBKIT_DISABLE_DMABUF_RENDERER=1 && npm run serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/bar/browser"
  },
  "app": {
    "windows": [
      {
        "title": "bar",
        "width": 800,
        "height": 600,
        "alwaysOnBottom": true,
        "skipTaskbar": true,
        "decorations": false,
        "visibleOnAllWorkspaces": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
