{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "meqeq-bar",
  "version": "0.1.0",
  "identifier": "com.meqeq-bar.app",
  "build": {
    "frontendDist": "../dist/meqeq-bar/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:angular"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
